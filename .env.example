# ============================================================
# AlertMind — Environment Configuration
# Copy to .env and fill all REQUIRED values before starting
# NEVER commit .env to version control
#
# Docker is NOT required. Recommended zero-install setup:
#   Database → Neon (neon.tech) — free serverless Postgres
#   Cache/Queue → Upstash (upstash.com) — free serverless Redis
#   File storage → local disk (default, no setup needed)
# Both take about 2 minutes to sign up for and give you a
# connection string to paste below. See docs/no-docker-setup.md.
# ============================================================

# ─── App ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────
# REQUIRED
# Option A (recommended, no install): sign up at neon.tech, create a
#   project, copy the connection string it gives you — paste it here as-is.
# Option B: a local Postgres install (native Windows/Mac installer, no
#   Docker needed) — postgresql.org/download
DATABASE_URL=postgresql://alertmind_user:STRONG_PASSWORD@localhost:5432/alertmind_db?schema=public&sslmode=require

# ─── Redis ──────────────────────────────────────────────────
# REQUIRED
# Option A (recommended, no install): sign up at upstash.com, create a
#   Redis database, then copy the Host/Port/Password from its dashboard
#   into the three fields below (set REDIS_TLS=true for Upstash).
# Option B: a local Redis install.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
REDIS_TLS=false

# ─── AI — Groq ──────────────────────────────────────────────
# REQUIRED — Get from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=8192
# Low temperature = deterministic, factual security analysis
GROQ_TEMPERATURE=0.1

# ─── Authentication ─────────────────────────────────────────
# REQUIRED — Generate with: node scripts/generate-secrets.js
AUTH_SECRET=GENERATE_STRONG_SECRET_HERE_MIN_64_CHARS

# REQUIRED — Generated by the same script above (RSA-4096, PKCS8 format)
# Do NOT use `openssl genrsa` directly — it produces PKCS1 format, which
# is incompatible with the jose library used for JWT verification in this project.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── CSRF Protection ────────────────────────────────────────
# REQUIRED — Generate with: node scripts/generate-secrets.js
CSRF_SECRET=GENERATE_STRONG_SECRET_HERE_MIN_64_CHARS

# ─── File Storage ───────────────────────────────────────────
# 'local' (default) — writes PDFs/exports to disk, zero setup, zero
#   external services. Right choice unless you're running multiple
#   horizontally-scaled app instances without shared storage.
# 'minio' — S3-compatible object storage, for that multi-instance case.
#   Only needed if you set STORAGE_PROVIDER=minio below.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/objects

# The following are ONLY required if STORAGE_PROVIDER=minio:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=alertmind_access
# MINIO_SECRET_KEY=STRONG_MINIO_SECRET
# MINIO_BUCKET=alertmind
# MINIO_USE_SSL=false

# ─── Sentry Error Tracking ──────────────────────────────────
# OPTIONAL — Get from https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─── OpenTelemetry ──────────────────────────────────────────
# OPTIONAL — leave blank to disable tracing entirely (safe default)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=alertmind
OTEL_SERVICE_VERSION=1.0.0

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# AI analysis endpoint — more restrictive
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=10

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── PDF Export ──────────────────────────────────────────────
# OPTIONAL — leave blank to auto-detect an installed Chrome/Edge browser
# (see src/shared/pdf/chromiumLocator.js). Only set this if auto-detection
# fails, e.g.:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=

# ─── Encryption ─────────────────────────────────────────────
# REQUIRED — For encrypting connector credentials at rest
# Generate with: node scripts/generate-secrets.js
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_HERE

# ─── Queue ──────────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_JOB_TIMEOUT_MS=120000

# ─── Session ────────────────────────────────────────────────
SESSION_EXPIRY_SECONDS=86400

# ─── Prometheus Metrics ─────────────────────────────────────
METRICS_PORT=9090
METRICS_ENABLED=true
